# EcoNet credentials (from your Rheem EcoNet account)
ECONET_EMAIL=
ECONET_PASSWORD=

# Supabase (from https://supabase.com/dashboard → Settings → API)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# Optional: Fernet key for encrypting stored credentials
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional: Stripe (for donation/premium features)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: PostgreSQL connection string (defaults to local SQLite)
DATABASE_URL=
